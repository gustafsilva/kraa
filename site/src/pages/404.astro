---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import { buttonVariants } from "@/components/ui/button";
import { href } from "@/lib/site";
---
<BaseLayout title="Página não encontrada" description="Esta página não existe.">
  <Header />
  <main class="mx-auto flex max-w-xl flex-col items-center px-4 py-32 text-center">
    <p class="font-mono text-sm text-brand">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">Página não encontrada</h1>
    <p class="mt-3 text-muted-foreground">O endereço pode ter mudado. Tente a documentação.</p>
    <div class="mt-8 flex gap-2">
      <a href={href("/")} class={buttonVariants({ variant: "outline" })}>Início</a>
      <a href={href("/docs/introducao/")} class={buttonVariants()}>Documentação</a>
    </div>
  </main>
</BaseLayout>
