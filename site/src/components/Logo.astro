---
import { href } from "@/lib/site";
interface Props { class?: string }
const { class: className = "" } = Astro.props;
---
<a href={href("/")} class:list={["group inline-flex items-center gap-2.5 font-semibold tracking-tight text-foreground", className]}>
  <img src={href("/favicon.svg")} alt="" width="26" height="26" class="size-6.5 transition-transform duration-300 group-hover:rotate-12" />
  <span>Prompt Improve</span>
</a>
