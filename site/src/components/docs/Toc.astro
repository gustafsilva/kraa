---
import type { MarkdownHeading } from "astro";
interface Props { headings: MarkdownHeading[] }
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 0 && (
  <nav aria-label="Nesta página" class="text-sm" data-toc>
    <h4 class="mb-3 text-xs font-medium tracking-wide text-muted-foreground/80 uppercase">Nesta página</h4>
    <ul class="space-y-2 border-l border-border/70">
      {items.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            class:list={[
              "-ml-px block border-l border-transparent py-0.5 text-muted-foreground transition-colors hover:text-foreground data-[active=true]:border-brand data-[active=true]:text-foreground",
              h.depth === 3 ? "pl-6" : "pl-3.5",
            ]}
          >{h.text.replace(/#$/, "").trim()}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
