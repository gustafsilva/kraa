---
import { NAV, href } from "@/lib/site";
interface Props { current: string }
const { current } = Astro.props;
---
<nav aria-label="Documentação" class="space-y-7 text-sm">
  {NAV.map((section) => (
    <div>
      <h4 class="mb-2 px-2.5 text-xs font-medium tracking-wide text-muted-foreground/80 uppercase">{section.title}</h4>
      <ul class="space-y-0.5">
        {section.items.map((item) => {
          const active = item.slug === current;
          return (
            <li>
              <a
                href={href(`/docs/${item.slug}/`)}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "relative block rounded-md px-2.5 py-1.5 transition-colors",
                  active
                    ? "bg-muted/70 font-medium text-foreground before:absolute before:inset-y-1.5 before:-left-px before:w-0.5 before:rounded-full before:bg-brand"
                    : "text-muted-foreground hover:bg-muted/40 hover:text-foreground",
                ]}
              >{item.title}</a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
