{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2022.Array on top of ES2020: Array.prototype.at(), used in tests.
    "lib": ["ES2020", "ES2022.Array", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@bindings/*": ["./bindings/*"]
    },

    /* Linting */
    "strict": true,
    // Off: shadcn/ui vendors components (e.g. scroll-area.tsx) with an
    // unused `import * as React` under the react-jsx runtime; those files
    // are regenerated by `shadcn add`, not hand-maintained for lint.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "bindings"]
}
