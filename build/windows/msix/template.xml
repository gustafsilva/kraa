<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="prompt-improve"
        Arguments=""
        InstallLocation="C:\Program Files\Matrix IA\Prompt Improve">
    </Installer>
    <PackageInformation
        PackageName="Prompt Improve"
        PackageDisplayName="Prompt Improve"
        PublisherName="CN=Matrix IA"
        PublisherDisplayName="Matrix IA"
        Version="0.1.0.0"
        PackageDescription="Melhore prompts e mensagens com IA a partir de qualquer app">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="dev.matrixia.prompt-improve"
                Description="Melhore prompts e mensagens com IA a partir de qualquer app"
                DisplayName="Prompt Improve"
                ExecutableName="prompt-improve"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Prompt Improve</DisplayName>
            <PublisherDisplayName>Matrix IA</PublisherDisplayName>
            <Description>Melhore prompts e mensagens com IA a partir de qualquer app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="prompt-improve.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
